# User-provided installers and generated binaries
*.exe
*.zip
*.bin
*.elf
*.map

# Project-local Arduino toolchain and caches
.tools/
.arduino/
build/

# Local assistant/workspace notes (not project source)
.workbuddy/
.workbuddy-ai/

# Generated browser previews and regression screenshots
outputs/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python bytecode from the host-side test tooling
__pycache__/
*.pyc

# Local secrets - never commit Wi-Fi credentials
.env
.env.local

# Build-time version override written by scripts\build.ps1 -Version.
# A debug build's suffix is local to whoever made it; only config.h is tracked.
firmware/MiRemoteBridge/version_local.h

