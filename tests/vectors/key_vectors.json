    },
    {
      "name": "duplicate release is swallowed",
      "input": [{ "code": 128, "pressed": true }, { "code": 0, "pressed": false }, { "code": 0, "pressed": false }],
      "expect": [{ "code": 128, "pressed": true }, { "code": 128, "pressed": false }]
    },
    {
      "name": "release with nothing held emits nothing",
      "input": [{ "code": 0, "pressed": false }],
      "expect": []
    },
    {
      "name": "new key without a release auto-releases the old one",
      "input": [{ "code": 82, "pressed": true }, { "code": 79, "pressed": true }],
      "expect": [{ "code": 82, "pressed": true }, { "code": 82, "pressed": false }, { "code": 79, "pressed": true }]
    },
    {
      "name": "release after an auto-release pair",
      "input": [{ "code": 82, "pressed": true }, { "code": 79, "pressed": true }, { "code": 0, "pressed": false }],
      "expect": [{ "code": 82, "pressed": true }, { "code": 82, "pressed": false }, { "code": 79, "pressed": true }, { "code": 79, "pressed": false }]
    },
    {
      "name": "zero press event is ignored",
      "input": [{ "code": 0, "pressed": true }],
      "expect": []
    }
  ],

